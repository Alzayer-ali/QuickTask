<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- App Icon / Badge Section -->
    <ImageView
        android:id="@+id/widget_bar_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_task_notification" />

    <!-- Text info: Title & Pending Tasks Count -->
    <LinearLayout
        android:id="@+id/widget_bar_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_bar_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Task"
            android:textColor="#E6E0E9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bar_task_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 pending"
            android:textColor="#CAC4D0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Trigger Notification Action Button -->
    <TextView
        android:id="@+id/widget_bar_btn_notify"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_secondary_pill"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="🔔 Notify"
        android:textColor="#E6E0E9"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Quick Add Task Button -->
    <TextView
        android:id="@+id/widget_bar_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_pill"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="+ Add"
        android:textColor="#381E72"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
