<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Header -->
    <RelativeLayout
        android:id="@+id/widget_list_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="My Tasks"
            android:textColor="#E6E0E9"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_list_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/widget_list_title"
            android:background="@drawable/widget_button_secondary_pill"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="0"
            android:textColor="#D0BCFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Add Button -->
        <TextView
            android:id="@+id/widget_list_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_button_pill"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+ Quick Add"
            android:textColor="#381E72"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Empty State View -->
    <TextView
        android:id="@+id/widget_list_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="All tasks done! 🎉"
        android:textColor="#938F99"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Tasks ListView -->
    <ListView
        android:id="@+id/widget_tasks_list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp" />

</LinearLayout>
