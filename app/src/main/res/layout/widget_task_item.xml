<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_task_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Priority Strip / Indicator (Using ImageView to comply with RemoteViews) -->
    <ImageView
        android:id="@+id/widget_item_priority_indicator"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginEnd="10dp"
        android:background="#D0BCFF"
        android:contentDescription="@null" />

    <!-- Task Title & Due details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Task Title"
            android:textColor="#E6E0E9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Due Today"
            android:textColor="#CAC4D0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
