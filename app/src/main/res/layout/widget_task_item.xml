<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_task_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_task_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Priority Strip -->
    <ImageView
        android:id="@+id/widget_item_priority_indicator"
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:background="#D0BCFF"
        android:contentDescription="@null" />

    <!-- Interactive Check Button (Tap to complete task directly from widget) -->
    <ImageView
        android:id="@+id/widget_item_check_btn"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Complete Task"
        android:padding="5dp"
        android:src="@drawable/widget_circle_check" />

    <!-- Task Title & Due details (Tap to open in app) -->
    <LinearLayout
        android:id="@+id/widget_item_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Task Title"
            android:textColor="#E6E0E9"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Due Today"
            android:textColor="#CAC4D0"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
