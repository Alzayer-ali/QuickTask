<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pill_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_card"
    android:padding="16dp">

    <!-- Glowing Circle with Add Symbol -->
    <TextView
        android:id="@+id/widget_pill_circle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_button_pill"
        android:gravity="center"
        android:text="+"
        android:textColor="#381E72"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Labels -->
    <TextView
        android:id="@+id/widget_pill_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_pill_circle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:text="Quick Task"
        android:textColor="#E6E0E9"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_pill_count_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_pill_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_button_secondary_pill"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:text="0 tasks"
        android:textColor="#D0BCFF"
        android:textSize="11sp" />

</RelativeLayout>
