<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Frosted Translucent Pill Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#2AFFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#10FFFFFF" />
        </shape>
    </item>

    <!-- Top Sheen -->
    <item
        android:top="1dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Subtle Edge Refraction (1dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#35FFFFFF" />
        </shape>
    </item>

</layer-list>
