<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Ambient droplet shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <!-- Layer 2: Frosted Glass Capsule Fill -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="135"
                android:startColor="#48FFFFFF"
                android:centerColor="#26FFFFFF"
                android:endColor="#1FFFFFFF" />
        </shape>
    </item>

    <!-- Layer 3: Top Glass Glint / Caustic Sheen -->
    <item
        android:top="1dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 4: Delicate Specular Edge Stroke (1dp refractive rim) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="#50FFFFFF" />
        </shape>
    </item>

</layer-list>
