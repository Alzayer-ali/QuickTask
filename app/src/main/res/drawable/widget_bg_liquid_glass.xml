<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Ambient soft blur / depth halo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#14000000" />
        </shape>
    </item>

    <!-- Layer 2: Translucent Frosted Crystal Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="135"
                android:startColor="#2AFFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#1F0D1527" />
        </shape>
    </item>

    <!-- Layer 3: Diffuse Frost Blur Simulation (Velvety milky light dispersion) -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="31dp" />
            <gradient
                android:angle="90"
                android:startColor="#12FFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#28FFFFFF" />
        </shape>
    </item>

    <!-- Layer 4: Top Specular Glass Reflection (Light catching top curved surface) -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp"
                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#3EFFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 5: Refined Liquid Glass Rim (Ultra-thin 1dp refractive bevel) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>

</layer-list>
