<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Ambient soft item shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#0D000000" />
        </shape>
    </item>

    <!-- Layer 2: Frosted Item Plate Base -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#26FFFFFF"
                android:centerColor="#16FFFFFF"
                android:endColor="#140D1527" />
        </shape>
    </item>

    <!-- Layer 3: Top Edge Specular Highlight -->
    <item
        android:top="1dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="17dp"
                android:topRightRadius="17dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- Layer 4: Delicate Glass Edge Stroke (1dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>

</layer-list>
